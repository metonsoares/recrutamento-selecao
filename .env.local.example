# Supabase — Project URL e anon key (seguros no frontend via RLS)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Supabase — Service Role Key (APENAS server-side! nunca exponha no frontend)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Código de acesso à pesquisa (opcional — A4)
# Se definido, os funcionários precisarão informar este código para começar.
# Ideal para impedir que pessoas de fora da empresa respondam.
# Exemplo: SURVEY_ACCESS_CODE=2605
# Deixe em branco (ou remova a linha) para desativar o código de acesso.
SURVEY_ACCESS_CODE=

# IMPORTANTE:
# 1. Copie este arquivo para .env.local e preencha com os valores reais
# 2. NUNCA commite o arquivo .env.local no git
# 3. Na Vercel, configure estas variáveis em Settings > Environment Variables
# 4. Ative "Disable Email Signup" no Supabase Auth para impedir cadastros externos
